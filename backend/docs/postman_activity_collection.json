{
  "info": {
    "name": "活动管理模块 - API 集合",
    "_postman_id": "b2a4a9d6-5c56-4b0f-9a35-activity-module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:5000" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "activityId", "value": "" },
    { "key": "versionId", "value": "" }
  ],
  "item": [
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/admin/login", "host": ["{{baseUrl}}"], "path": ["api", "admin", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"13900000002\",\n  \"password\": \"pass123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.environment.set('adminToken', json.data.tokens.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Create Activity Draft",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/admin/activities", "host": ["{{baseUrl}}"], "path": ["api", "admin", "activities"] },
        "body": { "mode": "raw", "raw": "{}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.environment.set('activityId', json.data.activity_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin List Activities",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/admin/activities?page=1&page_size=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "activities"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "20" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('has items', function () { pm.expect(json.data.items).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Get Activity Detail",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/admin/activities/{{activityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "activities", "{{activityId}}"]
        }
      }
    },
    {
      "name": "Admin Save Draft",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/activities/{{activityId}}/draft",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "activities", "{{activityId}}", "draft"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"活动草稿\",\n  \"subtitle\": \"\",\n  \"description\": \"\",\n  \"cover\": \"\",\n  \"location\": {\"address\": \"\", \"lat\": null, \"lng\": null},\n  \"start_at\": \"2026-05-02T10:30\",\n  \"end_at\": \"2026-05-02T12:00\",\n  \"signup_deadline\": \"2026-05-01T18:00\",\n  \"capacity\": 100,\n  \"tags\": [\"讲座\"],\n  \"fee_type\": \"free\",\n  \"ticket_tiers\": [],\n  \"form_fields\": []\n}"
        }
      }
    },
    {
      "name": "Admin Save (Validate)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/activities/{{activityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "activities", "{{activityId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"活动A\",\n  \"subtitle\": \"副标题\",\n  \"description\": \"详情\",\n  \"cover\": \"\",\n  \"location\": {\"address\": \"上海\", \"lat\": null, \"lng\": null},\n  \"start_at\": \"2026-05-02T10:30\",\n  \"end_at\": \"2026-05-02T12:00\",\n  \"signup_deadline\": \"2026-05-01T18:00\",\n  \"capacity\": 10,\n  \"tags\": [\"测试\"],\n  \"fee_type\": \"free\",\n  \"ticket_tiers\": [],\n  \"form_fields\": [{\"field_id\":\"f1\",\"label\":\"姓名\",\"type\":\"text\",\"required\":true,\"options\":[]}]\n}"
        }
      }
    },
    {
      "name": "Admin Publish Now",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/activities/{{activityId}}/publish",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "activities", "{{activityId}}", "publish"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"mode\": \"now\"\n}" }
      }
    },
    {
      "name": "Admin Versions",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/api/admin/activities/{{activityId}}/versions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "activities", "{{activityId}}", "versions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "if (Array.isArray(json.data) && json.data.length) { pm.environment.set('versionId', json.data[0]._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Rollback",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/activities/{{activityId}}/rollback",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "activities", "{{activityId}}", "rollback"]
        },
        "body": { "mode": "raw", "raw": "{\n  \"version_id\": \"{{versionId}}\"\n}" }
      }
    },
    {
      "name": "Public List Activities",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/activity/list?page=1&page_size=12",
          "host": ["{{baseUrl}}"],
          "path": ["api", "activity", "list"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "page_size", "value": "12" }
          ]
        }
      }
    },
    {
      "name": "Public Activity Detail",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/activity/{{activityId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "activity", "{{activityId}}"]
        }
      }
    }
  ]
}

